# --- CPRED Visualizer -------------------------------------------------------

# Artefatti di rilascio: li produce la CI (`tool/publish.dart`) e li pubblica
# Pages. Committarli significherebbe decine di MB nel repository per ogni
# rilascio, e prima o poi un archivio vecchio committato per errore.
/dist/
/site/*.zip
/site/*.AppImage
/site/*.exe
/site/latest.json
/public/

# Il catalogo oggetti invece **va committato**: e' un asset spedito con l'app, e
# c'e' un test che verifica che sia presente e coerente con il seed.
!assets/catalog/catalog.sqlite

# Progetto Java originale di riferimento (non deve essere incluso nel repository)
lol/
legacy/
CPRED_Visualizer/
*.cpred_sheet
*.cpredux
*.cpredux.backup
*.assets/

